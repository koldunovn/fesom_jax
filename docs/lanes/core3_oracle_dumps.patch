diff --git a/src/fesom_dump_core3.F90 b/src/fesom_dump_core3.F90
new file mode 100644
index 0000000..5bb2325
--- /dev/null
+++ b/src/fesom_dump_core3.F90
@@ -0,0 +1,272 @@
+!==============================================================================
+! fesom_dump_core3.F90 -- env-gated reference dumps of FESOM2 main for the
+! fesom_jax (fesom2-jax) verification ladder, ported from port2/fesom2's
+! fesom_dump_shim.F90 and extended for single precision, element fields and
+! ice-shelf cavities. A no-op unless FESOM_DUMP_DIR is set.
+!
+! Environment:
+!   FESOM_DUMP_DIR         output directory (required; enables the dumps)
+!   FESOM_DUMP_MAXSTEPS    record steps 1..MAXSTEPS (default 4)
+!   FESOM_DUMP_PROBES      text file of node global ids (1-based), one per line
+!   FESOM_DUMP_PROBES_ELEM text file of element global ids (1-based), one per line
+!   FESOM_DUMP_FULL_STEPS  also write FULL owned fields for steps 1..N (default 0)
+!
+! Probe files <dir>/probe_nod.<mype:05d> and <dir>/probe_elem.<mype:05d> use the
+! record layout of fesom_jax/io_dump.py (little-endian stream, no header):
+!   int32 step, int32 substep_id, int32 global_id (1-based), int32 nvals,
+!   char[24] field_name, real64 values[nvals]
+! A node column is written over levels 1..nlevels_nod2D(n) (cavity levels
+! 1..ulevels_nod2D-1 INCLUDED, as stored), an element column over
+! 1..nlevels(e)-1 (2-component element fields: all of component 1, then all
+! of component 2), a 2-D field as nvals=1. Values are converted to real64.
+!
+! Full fields <dir>/full/s<step>_<substep>_<name>.<mype:05d>:
+!   int32 n_owned, int32 ncol, int32 gid(n_owned), real64 vals(ncol, n_owned)
+! (the whole stored column, no truncation; owned nodes/elements only).
+!==============================================================================
+module fesom_dump_core3
+  use, intrinsic :: iso_fortran_env, only: int32, real32, real64
+  implicit none
+  private
+
+  integer, parameter, public :: DS_INIT=0, DS_PRESSURE_BV=1, DS_SW_AB=2, DS_PGF=3, DS_MIXING=4, &
+       DS_VEL_RHS=5, DS_VISC_FILTER=6, DS_IMPL_VISC=7, DS_SSH_RHS=8, DS_SSH_SOLVE=9, &
+       DS_UPDATE_VEL=10, DS_HBAR=11, DS_ETA_N=12, DS_ALE=13, DS_GM_BOLUS=14, DS_TRACERS=15, &
+       DS_THICKNESS=16, DS_ATM_FORCING=17, DS_ICE_STEP=18, DS_OCE_FLUXES=19
+
+  logical, save :: inited = .false.
+  logical, save, public :: dump_on = .false.
+  integer, save :: unit_nod = -1, unit_elem = -1
+  integer, save :: max_steps = 4, full_steps = 0, mype_s = 0
+  character(len=512), save :: ddir = ''
+  integer, allocatable, save :: pn_loc(:), pn_gid(:), pe_loc(:), pe_gid(:)
+  integer, allocatable, save :: gl_nod(:), gl_elem(:)
+  integer, save :: n_own_nod = 0, n_own_elem = 0
+
+  interface dump_nod
+     module procedure dump_nod_3d_r4, dump_nod_3d_r8, dump_nod_2d_r4, dump_nod_2d_r8
+  end interface
+  interface dump_elem
+     module procedure dump_elem_3d_r4, dump_elem_3d_r8, dump_elem_uv_r4, dump_elem_uv_r8, &
+                      dump_elem_2d_r4, dump_elem_2d_r8
+  end interface
+  public :: dump_core3_init, dump_nod, dump_elem, dump_core3_finalize, dump_active
+
+contains
+
+  logical function dump_active(step)
+    integer, intent(in) :: step
+    dump_active = dump_on .and. step >= 0 .and. step <= max_steps
+  end function dump_active
+
+  subroutine read_ids(path, ids)
+    character(len=*), intent(in) :: path
+    integer, allocatable, intent(out) :: ids(:)
+    integer :: u, ios, k, v, cnt
+    cnt = 0
+    open(newunit=u, file=trim(path), status='old', action='read', iostat=ios)
+    if (ios /= 0) then
+       allocate(ids(0)); return
+    end if
+    do
+       read(u, *, iostat=ios) v
+       if (ios /= 0) exit
+       cnt = cnt + 1
+    end do
+    rewind(u)
+    allocate(ids(cnt))
+    do k = 1, cnt
+       read(u, *) ids(k)
+    end do
+    close(u)
+  end subroutine read_ids
+
+  subroutine resolve(ids, mylist, ndim, loc)
+    integer, intent(in) :: ids(:), mylist(:), ndim
+    integer, allocatable, intent(out) :: loc(:)
+    integer :: i, j
+    allocate(loc(size(ids))); loc = -1
+    do i = 1, size(ids)
+       do j = 1, ndim
+          if (mylist(j) == ids(i)) then
+             loc(i) = j; exit
+          end if
+       end do
+    end do
+  end subroutine resolve
+
+  subroutine dump_core3_init(mype, myDim_nod2D, myList_nod2D, myDim_elem2D, myList_elem2D)
+    integer, intent(in) :: mype, myDim_nod2D, myDim_elem2D
+    integer, intent(in) :: myList_nod2D(:), myList_elem2D(:)
+    character(len=512) :: env, fname
+    integer :: ios, ln
+    integer, allocatable :: ids(:)
+    if (inited) return
+    inited = .true.
+    call get_environment_variable('FESOM_DUMP_DIR', ddir, length=ln, status=ios)
+    if (ios /= 0 .or. ln == 0) return
+    call get_environment_variable('FESOM_DUMP_MAXSTEPS', env, status=ios)
+    if (ios == 0 .and. len_trim(env) > 0) read(env, *, iostat=ios) max_steps
+    call get_environment_variable('FESOM_DUMP_FULL_STEPS', env, status=ios)
+    if (ios == 0 .and. len_trim(env) > 0) read(env, *, iostat=ios) full_steps
+    mype_s = mype
+    n_own_nod = myDim_nod2D; n_own_elem = myDim_elem2D
+    allocate(gl_nod(myDim_nod2D), gl_elem(myDim_elem2D))
+    gl_nod = myList_nod2D(1:myDim_nod2D); gl_elem = myList_elem2D(1:myDim_elem2D)
+    call get_environment_variable('FESOM_DUMP_PROBES', env, status=ios)
+    if (ios == 0 .and. len_trim(env) > 0) then
+       call read_ids(env, ids)
+    else
+       allocate(ids(0))
+    end if
+    pn_gid = ids
+    call resolve(ids, myList_nod2D, myDim_nod2D, pn_loc)
+    deallocate(ids)
+    call get_environment_variable('FESOM_DUMP_PROBES_ELEM', env, status=ios)
+    if (ios == 0 .and. len_trim(env) > 0) then
+       call read_ids(env, ids)
+    else
+       allocate(ids(0))
+    end if
+    pe_gid = ids
+    call resolve(ids, myList_elem2D, myDim_elem2D, pe_loc)
+    write(fname, '(A,"/probe_nod.",I5.5)') trim(ddir), mype
+    open(newunit=unit_nod, file=trim(fname), status='replace', form='unformatted', &
+         access='stream', action='write', iostat=ios)
+    if (ios /= 0) return
+    write(fname, '(A,"/probe_elem.",I5.5)') trim(ddir), mype
+    open(newunit=unit_elem, file=trim(fname), status='replace', form='unformatted', &
+         access='stream', action='write', iostat=ios)
+    if (ios /= 0) return
+    dump_on = .true.
+    if (mype == 0) print *, '[fesom_dump_core3] active: dir=', trim(ddir), ' max_steps=', max_steps, &
+         ' full_steps=', full_steps, ' node probes=', size(pn_gid), ' elem probes=', size(pe_gid)
+  end subroutine dump_core3_init
+
+  subroutine dump_core3_finalize()
+    if (.not. dump_on) return
+    close(unit_nod); close(unit_elem)
+    dump_on = .false.
+  end subroutine dump_core3_finalize
+
+  ! ---- the one real64 writer every interface goes through ---------------------
+  ! col(:, i): the stored column of owned point i (ncol values); nv(i): how many to
+  ! write to the probe record (the wet column), gids/locs: the probes.
+  subroutine emit(step, sub, name, unit, cols, nv, pgid, ploc, glist, nown)
+    integer, intent(in) :: step, sub, unit, nown
+    character(len=*), intent(in) :: name
+    real(real64), intent(in) :: cols(:,:)
+    integer, intent(in) :: nv(:), pgid(:), ploc(:), glist(:)
+    character(len=24) :: n24
+    character(len=700) :: fname
+    integer :: i, l, u, ios
+    n24 = name
+    do i = 1, size(pgid)
+       l = ploc(i)
+       if (l <= 0) cycle
+       write(unit) int(step,int32), int(sub,int32), int(pgid(i),int32), int(nv(l),int32), n24, &
+                   cols(1:nv(l), l)
+    end do
+    if (step <= full_steps) then
+       write(fname, '(A,"/full/s",I0,"_",I0,"_",A,".",I5.5)') trim(ddir), step, sub, trim(name), mype_s
+       open(newunit=u, file=trim(fname), status='replace', form='unformatted', access='stream', &
+            action='write', iostat=ios)
+       if (ios /= 0) return
+       write(u) int(nown,int32), int(size(cols,1),int32), int(glist(1:nown),int32), cols(:, 1:nown)
+       close(u)
+    end if
+  end subroutine emit
+
+  ! ---- nodes ----------------------------------------------------------------
+  subroutine dump_nod_3d_r8(step, sub, name, f, nlev)
+    integer, intent(in) :: step, sub
+    character(len=*), intent(in) :: name
+    real(real64), intent(in) :: f(:,:)
+    integer, intent(in) :: nlev(:)
+    integer :: nv(n_own_nod)
+    if (.not. dump_active(step)) return
+    nv = min(nlev(1:n_own_nod), size(f,1))
+    call emit(step, sub, name, unit_nod, f(:, 1:n_own_nod), nv, pn_gid, pn_loc, gl_nod, n_own_nod)
+  end subroutine dump_nod_3d_r8
+  subroutine dump_nod_3d_r4(step, sub, name, f, nlev)
+    integer, intent(in) :: step, sub
+    character(len=*), intent(in) :: name
+    real(real32), intent(in) :: f(:,:)
+    integer, intent(in) :: nlev(:)
+    if (.not. dump_active(step)) return
+    call dump_nod_3d_r8(step, sub, name, real(f(:, 1:n_own_nod), real64), nlev)
+  end subroutine dump_nod_3d_r4
+  subroutine dump_nod_2d_r8(step, sub, name, f)
+    integer, intent(in) :: step, sub
+    character(len=*), intent(in) :: name
+    real(real64), intent(in) :: f(:)
+    integer :: nv(n_own_nod)
+    if (.not. dump_active(step)) return
+    nv = 1
+    call emit(step, sub, name, unit_nod, reshape(f(1:n_own_nod), [1, n_own_nod]), nv, pn_gid, pn_loc, &
+              gl_nod, n_own_nod)
+  end subroutine dump_nod_2d_r8
+  subroutine dump_nod_2d_r4(step, sub, name, f)
+    integer, intent(in) :: step, sub
+    character(len=*), intent(in) :: name
+    real(real32), intent(in) :: f(:)
+    if (.not. dump_active(step)) return
+    call dump_nod_2d_r8(step, sub, name, real(f(1:n_own_nod), real64))
+  end subroutine dump_nod_2d_r4
+
+  ! ---- elements ---------------------------------------------------------------
+  subroutine dump_elem_3d_r8(step, sub, name, f, nlev)
+    integer, intent(in) :: step, sub
+    character(len=*), intent(in) :: name
+    real(real64), intent(in) :: f(:,:)
+    integer, intent(in) :: nlev(:)
+    integer :: nv(n_own_elem)
+    if (.not. dump_active(step)) return
+    nv = min(nlev(1:n_own_elem) - 1, size(f,1))
+    call emit(step, sub, name, unit_elem, f(:, 1:n_own_elem), nv, pe_gid, pe_loc, gl_elem, n_own_elem)
+  end subroutine dump_elem_3d_r8
+  subroutine dump_elem_3d_r4(step, sub, name, f, nlev)
+    integer, intent(in) :: step, sub
+    character(len=*), intent(in) :: name
+    real(real32), intent(in) :: f(:,:)
+    integer, intent(in) :: nlev(:)
+    if (.not. dump_active(step)) return
+    call dump_elem_3d_r8(step, sub, name, real(f(:, 1:n_own_elem), real64), nlev)
+  end subroutine dump_elem_3d_r4
+  ! (2, nl-1, elem) vectors: written as two named fields <name>_1, <name>_2
+  subroutine dump_elem_uv_r8(step, sub, name, f, nlev)
+    integer, intent(in) :: step, sub
+    character(len=*), intent(in) :: name
+    real(real64), intent(in) :: f(:,:,:)
+    integer, intent(in) :: nlev(:)
+    if (.not. dump_active(step)) return
+    call dump_elem_3d_r8(step, sub, trim(name)//'_1', f(1, :, 1:n_own_elem), nlev)
+    call dump_elem_3d_r8(step, sub, trim(name)//'_2', f(2, :, 1:n_own_elem), nlev)
+  end subroutine dump_elem_uv_r8
+  subroutine dump_elem_uv_r4(step, sub, name, f, nlev)
+    integer, intent(in) :: step, sub
+    character(len=*), intent(in) :: name
+    real(real32), intent(in) :: f(:,:,:)
+    integer, intent(in) :: nlev(:)
+    if (.not. dump_active(step)) return
+    call dump_elem_uv_r8(step, sub, name, real(f(:, :, 1:n_own_elem), real64), nlev)
+  end subroutine dump_elem_uv_r4
+  subroutine dump_elem_2d_r8(step, sub, name, f)
+    integer, intent(in) :: step, sub
+    character(len=*), intent(in) :: name
+    real(real64), intent(in) :: f(:)
+    integer :: nv(n_own_elem)
+    if (.not. dump_active(step)) return
+    nv = 1
+    call emit(step, sub, name, unit_elem, reshape(f(1:n_own_elem), [1, n_own_elem]), nv, pe_gid, pe_loc, &
+              gl_elem, n_own_elem)
+  end subroutine dump_elem_2d_r8
+  subroutine dump_elem_2d_r4(step, sub, name, f)
+    integer, intent(in) :: step, sub
+    character(len=*), intent(in) :: name
+    real(real32), intent(in) :: f(:)
+    if (.not. dump_active(step)) return
+    call dump_elem_2d_r8(step, sub, name, real(f(1:n_own_elem), real64))
+  end subroutine dump_elem_2d_r4
+
+end module fesom_dump_core3
diff --git a/src/fesom_dump_core3_hooks.F90 b/src/fesom_dump_core3_hooks.F90
