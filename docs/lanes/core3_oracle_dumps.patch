     use fesom_dump_core3_hooks, only: dump_core3_stage
-    use fesom_dump_core3, only: DS_ATM_FORCING, DS_ICE_STEP, DS_OCE_FLUXES
+    use fesom_dump_core3_hooks, only: dump_core3_state
+    use fesom_dump_core3, only: DS_ATM_FORCING, DS_ICE_STEP, DS_OCE_FLUXES, DS_PRE_FLUXES
 !   use openacc_lib
     integer, intent(in) :: current_nsteps
     ! EO parameters
@@ -1167,6 +1168,7 @@ contains
         end if
 #endif
             f%t_ice_oflx_s = MPI_Wtime()
+            call dump_core3_state(n, DS_PRE_FLUXES, f%dynamics, f%tracers, f%partit, f%mesh)
             call oce_fluxes_mom(f%ice, f%dynamics, f%partit, f%mesh) ! momentum only
             call oce_fluxes(f%ice, f%dynamics, f%tracers, f%partit, f%mesh)
             call dump_core3_stage(n, DS_OCE_FLUXES, f%ice, f%partit, f%mesh)
