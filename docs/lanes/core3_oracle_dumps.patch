+!==============================================================================
+! Forcing/ice-stage hooks of the fesom_jax reference dumps (see fesom_dump_core3.F90).
+! Called from the main loop (fesom_module.F90) after update_atm_forcing,
+! ice_timestep and oce_fluxes; a no-op unless FESOM_DUMP_DIR is set.
+!==============================================================================
+module fesom_dump_core3_hooks
+  use fesom_dump_core3
+  implicit none
+  private
+  public :: dump_core3_stage
+contains
+  subroutine dump_core3_stage(n, stage, ice, partit, mesh)
+    use MOD_MESH
+    use MOD_PARTIT
+    use MOD_ICE
+    use o_ARRAYS, only: heat_flux, water_flux, virtual_salt, relax_salt, stress_surf, stress_node_surf
+    use g_forcing_arrays, only: shortwave, longwave, Tair, shum, u_wind, v_wind, prec_rain, prec_snow, &
+                                real_salt_flux
+    integer,        intent(in)            :: n, stage
+    type(t_ice),    intent(inout), target :: ice
+    type(t_partit), intent(inout), target :: partit
+    type(t_mesh),   intent(inout), target :: mesh
+    call dump_core3_init(partit%mype, partit%myDim_nod2D, partit%myList_nod2D, &
+                         partit%myDim_elem2D, partit%myList_elem2D)
+    if (.not. dump_active(n)) return
+    select case (stage)
+    case (DS_ATM_FORCING)
+       call dump_nod(n, stage, 'shortwave', shortwave)
+       call dump_nod(n, stage, 'longwave', longwave)
+       call dump_nod(n, stage, 'Tair', Tair)
+       call dump_nod(n, stage, 'shum', shum)
+       call dump_nod(n, stage, 'u_wind', u_wind)
+       call dump_nod(n, stage, 'v_wind', v_wind)
+       call dump_nod(n, stage, 'prec_rain', prec_rain)
+       call dump_nod(n, stage, 'prec_snow', prec_snow)
+    case (DS_ICE_STEP)
+       call dump_nod(n, stage, 'a_ice', ice%data(1)%values)
+       call dump_nod(n, stage, 'm_ice', ice%data(2)%values)
+       call dump_nod(n, stage, 'm_snow', ice%data(3)%values)
+       call dump_nod(n, stage, 'uice', ice%uice)
+       call dump_nod(n, stage, 'vice', ice%vice)
+    case (DS_OCE_FLUXES)
+       call dump_nod(n, stage, 'heat_flux', heat_flux)
+       call dump_nod(n, stage, 'water_flux', water_flux)
+       call dump_nod(n, stage, 'virtual_salt', virtual_salt)
+       call dump_nod(n, stage, 'relax_salt', relax_salt)
+       call dump_nod(n, stage, 'real_salt_flux', real_salt_flux)
+       call dump_elem(n, stage, 'stress_surf_x', stress_surf(1, :))
+       call dump_elem(n, stage, 'stress_surf_y', stress_surf(2, :))
+       call dump_nod(n, stage, 'stress_node_surf_x', stress_node_surf(1, :))
+       call dump_nod(n, stage, 'stress_node_surf_y', stress_node_surf(2, :))
+       call dump_nod(n, stage, 'a_ice', ice%data(1)%values)
+    end select
+  end subroutine dump_core3_stage
+end module fesom_dump_core3_hooks
