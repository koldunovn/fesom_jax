index 7705384..76d2da9 100644
--- a/src/fesom_dump_core3_hooks.F90
+++ b/src/fesom_dump_core3_hooks.F90
@@ -7,8 +7,44 @@ module fesom_dump_core3_hooks
   use fesom_dump_core3
   implicit none
   private
-  public :: dump_core3_stage
+  public :: dump_core3_stage, dump_core3_state
 contains
+  ! The ocean state the forcing stage reads (before oce_fluxes_mom/oce_fluxes): the inputs of the cavity
+  ! three-equation melt and momentum fluxes (T, S, uvnode, uv, density, hnode, Z_3d_n, density_ref).
+  subroutine dump_core3_state(n, stage, dynamics, tracers, partit, mesh)
+    use MOD_MESH
+    use MOD_PARTIT
+    use MOD_DYN
+    use MOD_TRACER
+    use o_ARRAYS, only: density_m_rho0, density_ref
+    integer,        intent(in)            :: n, stage
+    type(t_dyn),    intent(inout), target :: dynamics
+    type(t_tracer), intent(inout), target :: tracers
+    type(t_partit), intent(inout), target :: partit
+    type(t_mesh),   intent(inout), target :: mesh
+    call dump_core3_init(partit%mype, partit%myDim_nod2D, partit%myList_nod2D, &
+                         partit%myDim_elem2D, partit%myList_elem2D)
+    if (.not. dump_active(n)) return
+    call dump_nod(n, stage, 'T', tracers%data(1)%values, mesh%nlevels_nod2D)
+    call dump_nod(n, stage, 'S', tracers%data(2)%values, mesh%nlevels_nod2D)
+    call dump_nod(n, stage, 'uvnode_1', dynamics%uvnode(1, :, :), mesh%nlevels_nod2D)
+    call dump_nod(n, stage, 'uvnode_2', dynamics%uvnode(2, :, :), mesh%nlevels_nod2D)
+    call dump_elem(n, stage, 'uv', dynamics%uv, mesh%nlevels)
+    call dump_nod(n, stage, 'density', density_m_rho0, mesh%nlevels_nod2D)
+    if (allocated(density_ref)) call dump_nod(n, stage, 'density_ref', density_ref, mesh%nlevels_nod2D)
+    call dump_nod(n, stage, 'hnode', mesh%hnode, mesh%nlevels_nod2D)
+    call dump_nod(n, stage, 'Z_3d_n', mesh%Z_3d_n, mesh%nlevels_nod2D)
+    call dump_nod(n, stage, 'eta_n', dynamics%eta_n)
+    call dump_nod(n, stage, 'hbar', mesh%hbar)
+    ! static geometry, to verify the fesom_jax mesh bundle (prepare_mesh.py --cavity) against FESOM itself
+    if (n == 1) then
+       call dump_nod(n, stage, 'area', mesh%area, mesh%nlevels_nod2D)
+       call dump_nod(n, stage, 'areasvol', mesh%areasvol, mesh%nlevels_nod2D)
+       call dump_nod(n, stage, 'mesh_resolution', mesh%mesh_resolution)
+       call dump_elem(n, stage, 'elem_area', mesh%elem_area)
+    end if
+  end subroutine dump_core3_state
+
   subroutine dump_core3_stage(n, stage, ice, partit, mesh)
     use MOD_MESH
     use MOD_PARTIT
