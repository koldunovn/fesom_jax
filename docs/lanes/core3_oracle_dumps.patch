+        call dump_nod(n, DS_PRESSURE_BV, 'pressure', hpressure, mesh%nlevels_nod2D)
+        call dump_nod(n, DS_PRESSURE_BV, 'bvfreq', bvfreq, mesh%nlevels_nod2D)
+    end if
 #if defined (FESOM_PROFILING)
     call fesom_profiler_end("pd_pressure_bv")
