@@ -3732,6 +3735,11 @@ subroutine oce_timestep_ale(n, ice, dynamics, tracers, partit, mesh)
     call fesom_profiler_start("pd_pressure_bv")
 #endif
     call pressure_bv(tracers, partit, mesh)
+    if (dump_active(n)) then
